{
  "name": "refino-monorepo",
  "private": true,
  "description": "Parse, validate and query Constraint Refinement Graphs (CRG).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leawind/refino.git"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "cli": "node packages/cli/dist/index.js",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7",
    "vue": "^3.5.42"
  }
}

{
  "name": "@refino/storage",
  "version": "0.1.0",
  "description": "Filesystem storage format for Constraint Refinement Graphs (CRG): the sole reader and writer of the .refino/ directory.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "refino": "workspace:^",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@refino/testkit": "workspace:*"
  }
}

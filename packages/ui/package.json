{
  "name": "@refino/ui",
  "version": "0.0.1",
  "private": true,
  "description": "Vue 3 visualization and editing components for Constraint Refinement Graphs (CRG), plus an embeddable editor application shell.",
  "type": "module",
  "exports": {
    "./static": "./dist",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "@refino/harness": "workspace:^",
    "katex": "^0.18.5",
    "marked": "^18.0.11",
    "marked-katex-extension": "^5.1.12",
    "mermaid": "^11.17.2",
    "naive-ui": "^2.45.3",
    "refino": "workspace:^",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.10"
  },
  "devDependencies": {
    "@refino/testkit": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "vite": "^7.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.0.0"
  }
}

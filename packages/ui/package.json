{
  "name": "@refino/ui",
  "version": "0.0.1",
  "private": true,
  "description": "Vue 3 visualization and editing components for Constraint Refinement Graphs (CRG), plus an embeddable editor application shell.",
  "type": "module",
  "exports": {
    "./static": "./dist",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@refino/testkit": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}

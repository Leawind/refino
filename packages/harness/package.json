{
  "name": "@refino/harness",
  "version": "0.0.2",
  "private": false,
  "description": "Task delimitation layer and shared agent logic for Constraint Refinement Graphs (CRG): authorization contexts, frozen zones, boundary escalation, context rendering and incremental updates.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leawind/refino.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "refino": "workspace:^"
  },
  "devDependencies": {
    "@refino/testkit": "workspace:*"
  }
}

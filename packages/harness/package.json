{
  "name": "@refino/harness",
  "version": "0.0.4",
  "private": false,
  "description": "Task context, tool-plugin cores and incremental updates for Decision Lineage Graphs (DLG): anchors, context rendering, review debt, query and write cores.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leawind/refino.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "refino": "workspace:^",
    "@refino/storage": "workspace:^"
  },
  "devDependencies": {
    "@refino/testkit": "workspace:*"
  }
}

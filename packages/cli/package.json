{
  "name": "@refino/cli",
  "version": "0.1.0",
  "description": "Command line interface for querying Constraint Refinement Graphs (CRG).",
  "type": "module",
  "bin": {
    "refino": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "refino": "workspace:^",
    "@refino/storage": "workspace:^",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@refino/testkit": "workspace:*"
  }
}

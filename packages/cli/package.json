{
  "name": "@refino/cli",
  "version": "0.0.1",
  "description": "Command line interface for querying Constraint Refinement Graphs (CRG).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leawind/refino.git"
  },
  "bin": {
    "refino": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@refino/storage": "workspace:^",
    "@refino/ui": "workspace:^",
    "commander": "^15.0.0",
    "hono": "^4.13.5",
    "refino": "workspace:^"
  },
  "devDependencies": {
    "@refino/testkit": "workspace:*"
  }
}
